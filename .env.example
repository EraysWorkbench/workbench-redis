###############################################
# Workbench Redis – .env.example
# --------------------------------------------
# Copy this file to ".env" and edit as needed.
# Default: password-protected Redis with protected-mode ON.
# Alternative (dev quick): no password + protected-mode OFF (see below).
###############################################

# -------------------------------
# Common host port mappings
# -------------------------------
# Redis on localhost:6379
REDIS_PORT=6379

# Web UI (redis-commander) on localhost:8081
UI_PORT=8081


#######################################################################
# DEFAULT (RECOMMENDED): PASSWORD-PROTECTED REDIS + PROTECTED-MODE ON
# --------------------------------------------------------------------
# 1) Ensure server/redis.conf has:
#      protected-mode yes
#      requirepass <same value as REDIS_PASSWORD below>
# 2) The UI connects over the compose internal network to service "dev-redis".
# 3) Use the 5-field REDIS_HOSTS form: name:host:port[:db][:password]
#######################################################################

# Change this before first run (must match server/redis.conf "requirepass"):
REDIS_PASSWORD=change_me_first

# UI connects to the Redis service by name (compose internal network).
# Format: name:host:port[:db][:password]  → here DB=0, password provided.
REDIS_HOSTS=local:dev-redis:6379:0:${REDIS_PASSWORD}

# Optional HTTP Basic Auth for the UI (redis-commander).
# Uncomment BOTH to enable.
# HTTP_USER=admin
# HTTP_PASSWORD=change_me


#######################################################################
# ALTERNATIVE (DEV QUICK): NO PASSWORD + PROTECTED-MODE OFF
# --------------------------------------------------------------------
# Use this only for quick local experiments. To switch:
#  - Edit server/redis.conf:
#       protected-mode no
#       # requirepass ...  (comment it out)
#  - Then comment out the DEFAULT block above and uncomment the lines below.
#######################################################################
# REDIS_HOSTS=local:dev-redis:6379
# (HTTP Basic Auth is independent; you can still protect the UI if desired.)
# HTTP_USER=admin
# HTTP_PASSWORD=change_me


#######################################################################
# NOTES
# --------------------------------------------------------------------
# • Host-native apps (not in Docker) should point to:
#     REDIS_HOST=127.0.0.1
#     REDIS_PORT=${REDIS_PORT}
#
# • Other Docker projects (outside this compose) cannot resolve "dev-redis".
#   They should use your host bridge:
#     Linux bridge (commonly):  REDIS_HOST=172.17.0.1
#     Or (if available):        REDIS_HOST=host.docker.internal
#   REDIS_PORT remains ${REDIS_PORT} unless you change the mapping above.
#
# • Laravel isolation per project (set uniquely in each app):
#     REDIS_DB, REDIS_CACHE_DB, REDIS_PREFIX, HORIZON_PREFIX
#
# • After any .env changes, recreate containers:
#     docker compose up -d --force-recreate
#######################################################################
